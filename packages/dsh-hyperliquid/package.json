{
  "name": "dsh-hyperliquid",
  "version": "0.1.0",
  "description": "Hyperliquid trading desk for the DeepSeek Harness (dsh) - market workspace, native agent conversation and guarded live / paper trading over the Hyperliquid API.",
  "icon": "./icon.svg",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "skills",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "NOTICE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "hyperliquid",
    "perps",
    "trading"
  ],
  "license": "MIT",
  "author": "dushaobindoudou",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:watch": "node scripts/build-client.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.client.json",
    "test": "node test/signing.test.mjs && node test/signing-web3.test.mjs && node test/exchange-nonce.test.mjs && node test/store.test.mjs && node test/trading-guard.test.mjs && node test/paper-risk.test.mjs && node test/network-switch.test.mjs && node test/account-data.test.mjs && node test/market-data.test.mjs && node test/market-symbol.test.mjs && node test/indicators.test.mjs && node test/chart-marks.test.mjs && node test/history.test.mjs && node test/skill.test.mjs && node test/markers.test.mjs && node test/client-integration.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@nktkas/hyperliquid": "^0.33.3",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dushaobindoudou/dsh-plugin.git",
    "directory": "packages/dsh-hyperliquid"
  },
  "homepage": "https://github.com/dushaobindoudou/dsh-plugin/tree/main/packages/dsh-hyperliquid#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dsh-web3": "^0.8.1",
    "esbuild": "^0.28.2",
    "ethers": "^6.13.0",
    "lightweight-charts": "^5.2.1",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
